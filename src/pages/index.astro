---
import '../styles/global.css';
import bankData from '../data/romanos.json';
import { parseQuestionBank } from '../lib/questionBank';

parseQuestionBank(bankData);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Quiz bíblico mobile-first para el libro de Romanos." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Quiz bíblico de Romanos</title>
  </head>
  <body>
    <main class="flex min-h-screen items-center px-4 py-8 sm:px-6">
      <div data-quiz-root class="w-full" aria-live="polite"></div>
    </main>
    <script>
      import { initRomanosQuiz } from '../lib/client';
      import bankData from '../data/romanos.json';

      initRomanosQuiz(bankData);
    </script>
  </body>
</html>
